  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background-color: #1a202c;
}

QFrame#sidebarFrame {
    background-color: #293043;
    border-right: 2px solid #2d3748;
}

QFrame#profileFrame {
    background-color: #38516f;
    border: 1px solid #ffffff;
    border-radius: 10px;
}

QFrame#distractionFrame,
QFrame#drowsyFrame {
    background-color: #38516f;
    border: 1px solid #ffffff;
    border-radius: 10px;
    padding: 6px;
}

QHBoxLayout#actionIconRow {
    display: flex;
    width: 116px;
    height: 20px;
    padding: 10px;
    justify-content: flex-end;
    align-items: center;
    gap: 7px;
    flex-shrink: 0;
}

QFrame#actionFrame,
QFrame#expressionFrame,
QFrame#eyeOpFrame,
QFrame#blinkFrame,
QFrame#headLocFrame,
QFrame#eyeLocFrame,
QFrame#headDirFrame,
QFrame#gazeDirFrame,
QFrame#gazeZoneFrame,
QFrame#headZoneFrame {
    border: 0;
    border-bottom: 1px solid #38516f;
    padding: 2px;
}

QLabel {
    color: #a0aec0;
    font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
    font-size: 11px;
    font-weight: bold;
}

QLabel#driverName {
    color: #ffffff;
    border: 0;
    font-size: 14px;
    min-height: 20px;
}

QLabel#lblDistractionVal,
QLabel#lblDrowsyVal {
    color: #ffffff;
    font-size: 20px;
}

QLabel#lblDistractionTitle,
QLabel#lblDrowsyTitle {
    color: #83DDDC;
    font-size: 11px;
}

QLabel#lblActionTitle,
QLabel#lblExpTitle,
QLabel#lblEyeOpTitle,
QLabel#lblBlinkTitle,
QLabel#lblHeadLocTitle,
QLabel#lblEyeLocTitle,
QLabel#lblHeadDirTitle,
QLabel#lblGazeDirTitle,
QLabel#lblGazeZoneTitle,
QLabel#lblHeadZoneTitle {
    color: #83DDDC;
    font-size: 13px;
}

QLabel#lblExpVal,
QLabel#lblEyeOpL,
QLabel#lblEyeOpR,
QLabel#lblBlinkVal,
QLabel#lblBlinkRVal,
QLabel#lblHeadLocVal,
QLabel#lblHeadLocYVal,
QLabel#lblHeadLocZVal,
QLabel#lblEyeLocLPrefix,
QLabel#lblEyeLocRPrefix,
QLabel#lblEyeLocVal,
QLabel#lblEyeLocLYVal,
QLabel#lblEyeLocLZVal,
QLabel#lblEyeLocRXVal,
QLabel#lblEyeLocRYVal,
QLabel#lblEyeLocRZVal,
QLabel#lblHeadDirVal,
QLabel#lblHeadDirYawVal,
QLabel#lblHeadDirRollVal,
QLabel#lblGazeDirVal,
QLabel#lblGazeDirYawVal,
QLabel#lblGazeZoneVal,
QLabel#lblHeadZoneVal {
    color: #EDA200;
    border-bottom: 0;
    font-size: 12px;
    padding: 5px 0;
    qproperty-alignment: AlignCenter;
}

QLabel#notifyBar {
    background-color: #34394c;
    color: #fc8181;
    font-size: 15px;
}

QLabel#videoLabel {
    background-color: #0d1117;
}

QLabel#captionBar {
    background-color: #34394a;
    color: #a0aec0;
    border-top: 1px solid #2d3748;
    font-size: 12px;
    font-weight: normal;
}

QPushButton {
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 8px;
    font-weight: bold;
    stroke-width: 2px;
    stroke: #FFF;
}

QLabel#lblRegValue,
QLabel#lblExpVal {
    color: #B04A4A;
    font-size: 12px;
    min-height: 16px;
}

</string>
